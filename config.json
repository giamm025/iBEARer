{
    "experiment": {
        "experiment_name": "reddit_cospiracy",
        "experiment_duration_minutes": 30       
    },

    "telemetry_settings": {
        "track_events": ["DOM_MUTATION", "USER_CLICK"],
        "sync_interval_ms": 10000
    },

    "target": {
        "url_pattern": "*://*.reddit.com/*",
        "selectors": "shreddit-post" 
    },
    
    "triggers": [
        {
            "name": "Text AND Link Checking",
            "description": "This Trigger activates when...",
            "event_source": "DOM_MUTATION",
            "target_selector": "h1, h2, p, a",
            "logical_operator": "AND",
            "conditions": [

                {
                    "property": "innerText",
                    "operator": "CONTAINS",
                    "value": ["epstein", "vaccini", "terra piatta", "5g"]
                },

                {
                    "property": "href",
                    "operator": "NOT_CONTAINS",
                    "value": ["wikipedia.org"]
                }
            ],
            "apply_interventions": ["HIDE", "DEBUNKING"]
        }
    ],
    
    "interventions": [
        {
            "name": "HIDE",
            "action_type": "APPLY_CSS",
            "payload": {
                "css_text": "display: none !important; opacity: 0;"
            }
        },
        {
            "name": "DEBUNKING",
            "action_type": "INJECT_HTML",
            "payload": {
                "position": "beforebegin",
                "html_content": "<div style='background: red; color: white; padding: 5px;'>⚠️ Attenzione: Questo post contiene informazioni non verificate.</div>"
            }
        },
        {
            "name": "RERANKING",
            "action_type": "DOM_MANIPULATION",
            "payload": {
                "operation": "move_to_bottom"
            }
        }
    ]
}