{
    "experiment": {
        "experiment_name": "reddit_cospiracy",
        "experiment_duration_minutes": 30       
    },

    "telemetry_settings": {
        "track_events": [
            "telemetry.events.ClickOnLinkEvent", 
            "telemetry.events.ScrollEvent", 
            "telemetry.events.UpvoteEvent", 
            "telemetry.events.TimeOnPageEvent", 
            "telemetry.events.SearchSubmittedEvent", 
            "telemetry.events.InterventionAppliedEvent"
        ],
        "sync_interval_ms": 10000
    },

    "target": {
        "url_pattern": "*://*.reddit.com/*",
        "dependency": "adapters/reddit_adapter.js"
    },
    
    "triggers": [
        {
            "name": "Search Results Checking",
            "description": "This Trigger activates when...", 

            "id": "trigger_contains_conspiracy",
            "event_source": "adapters.events.SearchResultsLoadedEvent",
            "logical_operator": "AND",
            "conditions": [

                {
                    "property": "search_query",
                    "operator": "CONTAINS_ANY",
                    "value": ["epstein", "vaccini", "terra piatta", "5g"]
                },

                {
                    "property": "post_links",
                    "operator": "NOT_CONTAINS_ANY",
                    "value": ["wikipedia.org"]
                }
            ],

            "apply_interventions": [
                "hide_content",
                "show_warning_banner",
                "demote_post"
            ]
        }
    ],
    
    "interventions": [
        {
            "name": "Hide Post",
            "description": "This Intervention hides the content of the post.",

            "id": "hide_content",
            "function_fqn": "interventions.hideContent",
            "payload": {}
        },

        {
            "name": "Inject Debunking",
            "description": "This Intervention displays a warning banner for false information.",

            "id": "show_warning_banner",
            "function_fqn": "interventions.showWarningBanner",
            "payload": {
                "message": "⚠️ ATTENZIONE! Informazioni false."
            }
        },

        {
            "name": "Demote Post",
            "description": "This Intervention moves the post to the bottom of the list.",

            "id": "demote_post",
            "function_fqn": "interventions.demotePost",
            "payload": {
                "new_position": "bottom"
            }
        }
    ]
}