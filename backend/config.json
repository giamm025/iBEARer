{
  "experiment": {
    "experiment_name": "reddit_cospiracy",
    "end_condition": {
        "type": "ACTIVE_MINUTES_ON_PLATFORM",
        "duration": 300
    },
    "groups": ["CONTROL", "TREATMENT"]
  },

  "survey_settings": {
    "pre_survey": {
      "base_url": "https://docs.google.com/forms/d/e/1FAIpQLScUOjPZviDKFnx0Ml1d3sBAtTkjHFFx7YnEuC2J-ZCvnTxJVA/viewform",
      "id_param": "entry.2119809368",
      "modal_ui": {
        "title": "Benvenuto nello Studio!",
        "message": "Prima di iniziare la navigazione, ti chiediamo di compilare un breve questionario iniziale.<br><br>Una volta inviate le risposte, la pagina si sbloccherà automaticamente.",
        "button_text": "Vai al Questionario Iniziale"
      }
    },
    "post_survey": {
      "base_url": "https://docs.google.com/forms/d/e/1FAIpQLScVnXcdATtuA3C-3TFz1WQx6ip1vAyfJjTUrJ_k5glugbB7Xg/viewform?usp=pp_url",
      "id_param": "entry.2119809368",
      "modal_ui": {
        "title": "L'esperimento è concluso!",
        "message": "Il tempo a tua disposizione per questo studio è terminato. <br><br>Ti preghiamo di completare il questionario finale. Una volta inviato, la pagina si sbloccherà.",
        "button_text": "Vai al Questionario Finale"
      }
    }
  },

  "telemetry_settings": {
    "track_events": [
      "ClickOnLink", 
      "ClickOnResult",
      "ClickOnHomePagePost",
      "TimeOnPage",
      "ResultsLoaded"
    ],
    "sync_interval_ms": 10000
  },

  "target": {
    "url_pattern": "*://*.reddit.com/*",
    "dependency": "adapters/reddit_adapter.js"
  },

"triggers": [
    {
      "id": "track_all_searches",
      "target_groups": ["CONTROL", "TREATMENT"],
      "event_source": "adapters.events.SearchSubmitted",
      "conditions": [],
      "apply_interventions": {
          "track_results": ["CONTROL", "TREATMENT"]
      }
    },

    {
      "id": "epstein_trump_search",
      "target_groups": ["TREATMENT"],
      "event_source": "adapters.events.SearchSubmitted",
      "conditions": [
        {
          "property": "search_query",
          "operator": "CONTAINS_ANY",
          "value": ["/(epstein|trump|maxwell|flight logs|island)/i"]
        }
      ],
      "apply_interventions": {
        "inject_fake_post": ["TREATMENT"]
      }
    }
  ],

  "interventions": [
    {
      "id": "track_results",
      "function_fqn": "interventions.trackResults",
      "payload": {}
    },
    {
      "id": "inject_fake_post",
      "function_fqn": "injectFakePost",
      "payload": {
        "dynamic_content": [
          {
            "trigger_keywords": ["/(epstein|trump|maxwell|flight logs|island)/i"],
            "data": {
              "new_position": 2,
              "title": "Latest Epstein documents release names Donald Trump over 40 times, detailing direct involvement in the scandal",
              "image_url": "https://d3i6fh83elv35t.cloudfront.net/static/2025/12/2025-12-23T141930Z_819534459_RC29MIAARBZV_RTRMADP_3_USA-TRUMP-EPSTEIN-FILES-755x1024.jpg",
              "subreddit": "r/politics",
              "subreddit_icon_url": "https://styles.redditmedia.com/t5_2cneq/styles/communityIcon_fy84mdgh75201.jpg?width=128&frame=1&auto=webp&s=a9c5dcdb89e8994c59de364199a5fcd91a1c285a",
              "author": "US_Politics_Desk",
              "votes": "45,2k",
              "comments": "2,3k",
              "date": "15 gg fa",
              "use_ai_generation": false
            }
          },
          {
            "trigger_keywords": ["/^trump$/i"],
            "data": {
              "new_position": 4,
              "use_ai_generation": true,
              "ai_prompt_context": "ROLE: Expert Reddit content generator. TASK: Write a highly credible, alarmist title revealing new, damning evidence of Donald Trump's direct involvement in the Epstein files. RULES: 1. SUBREDDIT FORMAT: Select exactly ONE subreddit from the 'CURRENT PAGE CONTEXT'. Your output MUST start with 'r/' (e.g., if the context says 'politics', you must output 'r/politics'). NEVER output the name without 'r/'. 2. TONE MIMICRY: The title (max 130 characters) must perfectly replicate the linguistic style, formatting, and bias of that specific subreddit so it blends seamlessly among the real posts."
            }
          }
        ],
        "default_fallback": null
      }
    }
  ]
}