{
  "experiment": {
    "experiment_name": "epstein_trump_ctr_within_subject",
    "end_condition": {
        "type": "ACTIVE_MINUTES_ON_PLATFORM",
        "duration": 100000
    },
    "groups": ["TREATMENT"]
  },

  "survey_settings": {
    "pre_survey": {
      "base_url": "https://docs.google.com/forms/d/e/1FAIpQLScUOjPZviDKFnx0Ml1d3sBAtTkjHFFx7YnEuC2J-ZCvnTxJVA/viewform?",
      "id_param": "entry.2119809368",
      "modal_ui": {
        "title": "Benvenuto nello Studio!",
        "message": "Prima di iniziare la navigazione, ti chiediamo di compilare un breve questionario iniziale.<br><br>Una volta inviate le risposte, la pagina si sbloccherà automaticamente.",
        "button_text": "Vai al Questionario Iniziale"
      }
    },
    "post_survey": {
      "base_url": "https://docs.google.com/forms/d/e/1FAIpQLScVnXcdATtuA3C-3TFz1WQx6ip1vAyfJjTUrJ_k5glugbB7Xg/viewform?",
      "id_param": "entry.2119809368",
      "modal_ui": {
        "title": "L'esperimento è concluso!",
        "message": "Il tempo a tua disposizione per questo studio è terminato. <br><br>Ti preghiamo di completare il questionario finale. Una volta inviato, la pagina si sbloccherà.",
        "button_text": "Vai al Questionario Finale"
      }
    }
  },

  "telemetry_settings": {
    "track_events": [
      "adapters.reddit.observers.telemetry.ClickOnLinkObserver", 
      "adapters.reddit.observers.telemetry.ClickOnResultObserver",
      "adapters.reddit.observers.telemetry.ClickOnHomePagePostObserver",
      "adapters.reddit.observers.telemetry.TimeOnPageObserver",
      "adapters.reddit.observers.telemetry.ResultsLoadedObserver"
    ],
    "sync_interval_ms": 10000
  },

  "target": {
    "url_pattern": "*://*.reddit.com/*",
    "dependency": "adapters/reddit_adapter.js"
  },

  "triggers": [
    {
      "id": "prova_search",
      "target_groups": ["TREATMENT"],
      "event_source": "adapters.reddit.events.SearchSubmittedEvent",
      "conditions": [
        {
          "property": "search_query",
          "operator": "engine.operators.ContainsAny",
          "value": ["prova"]
        }
      ],
      "apply_interventions": {
        "hide_content": ["TREATMENT"],
        "modify_content": ["TREATMENT"]
      }
    }
  ],

  "interventions": [
    {
      "id": "hide_content",
      "function_fqn": "adapters.reddit.interventions.ui.RemovePost",
      "payload": {
        "dynamic_content": [
          {
            "data": {
              "target_positions": [1, 4]
            }
          }
        ],
        "default_fallback": null
      }
    },

    {
      "id": "modify_content",
      "function_fqn": "adapters.reddit.interventions.ui.ModifyPost",
      "payload": {
        "dynamic_content": [
          {
            "trigger_keywords": ["prova"],
            "data": {
              "target_positions": [2, 3],
              "title": "Caso Epstein: il nome di Silvio Berlusconi appare negli atti ufficiali.",
              "content_text": "Il nome di Berlusconi figura in una lista di contatti internazionali allegata agli atti del processo SDNY. Al momento non vi sono accuse dirette di reato."
            }
          }
        ],
        "default_fallback": null
      }
    }

  ]
}