{
  "experiment": {
    "experiment_name": "reddit_cospiracy",
    "end_condition": {
        "type": "ACTIVE_MINUTES_ON_PLATFORM",
        "duration": 300
    },
    "groups": ["CONTROL", "TREATMENT1", "TREATMENT2"]
  },

  "survey_settings": {
    "pre_survey": {
      "base_url": "https://docs.google.com/forms/d/e/1FAIpQLScUOjPZviDKFnx0Ml1d3sBAtTkjHFFx7YnEuC2J-ZCvnTxJVA/viewform",
      "id_param": "entry.2119809368",
      "modal_ui": {
        "title": "Benvenuto nello Studio!",
        "message": "Prima di iniziare la navigazione, ti chiediamo di compilare un breve questionario iniziale.<br><br>Una volta inviate le risposte, la pagina si sbloccherà automaticamente.",
        "button_text": "Vai al Questionario Iniziale"
      }
    },
    "post_survey": {
      "base_url": "https://docs.google.com/forms/d/e/1FAIpQLScVnXcdATtuA3C-3TFz1WQx6ip1vAyfJjTUrJ_k5glugbB7Xg/viewform?usp=pp_url",
      "id_param": "entry.2119809368",
      "modal_ui": {
        "title": "L'esperimento è concluso!",
        "message": "Il tempo a tua disposizione per questo studio è terminato. <br><br>Ti preghiamo di completare il questionario finale. Una volta inviato, la pagina si sbloccherà.",
        "button_text": "Vai al Questionario Finale"
      }
    }
  },

  "telemetry_settings": {
    "track_events": [
      "ClickOnLink", 
      "ClickOnResult",
      "ResultsLoaded"
    ],
    "sync_interval_ms": 10000
  },

  "target": {
    "url_pattern": "*://*.reddit.com/*",
    "dependency": "adapters/reddit_adapter.js"
  },

  "triggers": [
    {
      "id": "every_search",
      "target_groups": ["CONTROL", "TREATMENT1", "TREATMENT2"],
      "event_source": "adapters.events.SearchSubmitted",
      "logical_operator": "AND",
      "conditions": [],
      "apply_interventions": {
          "track_results": ["CONTROL", "TREATMENT1", "TREATMENT2"]
      }
    },
    {
      "id": "trigger_contains_conspiracy",
      "target_groups": ["TREATMENT1", "TREATMENT2"],
      "event_source": "adapters.events.SearchSubmitted",
      "logical_operator": "AND",
      "conditions": [
        {
          "property": "search_query",
          "operator": "CONTAINS_ANY",
          "value": ["epstein", "vaccini", "terra piatta", "5g"]
        }
      ],
      "apply_interventions": {
        "apply_red_border": [ "TREATMENT1"],
        "inject_debunking": ["TREATMENT1"],
        "inject_fake_post_vaccines_ai": ["TREATMENT1", "TREATMENT2"],
        "inject_fake_post_vaccines": ["TREATMENT1", "TREATMENT2"],
        "modify_post": ["TREATMENT1", "TREATMENT2"]
      }
    },
    {
      "id": "trigger_contains_roast_me",
      "target_groups": ["TREATMENT1", "TREATMENT2"],
      "event_source": "adapters.events.SearchSubmitted",
      "logical_operator": "AND",
      "conditions": [
        {
          "property": "search_query",
          "operator": "CONTAINS_ANY",
          "value": ["roast me"]
        }
      ],
      "apply_interventions": {
        "hide_post": ["TREATMENT1", "TREATMENT2"]
      }
    }
  ],

  "interventions": [
    {
      "id": "apply_red_border",
      "function_fqn": "interventions.debug.applyBorder",
      "payload": {
          "border_style": "30px solid red"
      }
    },

    {
      "id": "apply_green_border",
      "function_fqn": "interventions.debug.applyBorder",
      "payload": {
          "border_style": "30px solid green"
      }
    },

    {
      "id": "inject_debunking",
      "function_fqn": "interventions.ui.showDebunkingBanner",
      "payload": {}
    },

    {
      "id": "track_results",
      "function_fqn": "interventions.trackResults",
      "payload": {}
    },
    {
      "id": "inject_fake_post_vaccines",
      "function_fqn": "injectFakePost",
      "payload": {
          "title": "🔴 La verità scientifica sui Vaccini MRNA",
          "subreddit": "r/MinisteroDellaSalute",
          "author": "ScienzaUfficiale",
          "content_text": "L'Organizzazione Mondiale della Sanità conferma che i vaccini sono sicuri ed efficaci. Non fidarti delle fonti non verificate su Reddit. Clicca qui per leggere il report ufficiale.",
          "target_url": "https://www.who.int/health-topics/vaccines-and-immunization",
          "date": "1 anno fa",
          "votes": 100,
          "comments": 50,
          "new_position": 2
      }
    },
    {
      "id": "inject_fake_post_vaccines_ai",
      "function_fqn": "injectFakePost",
      "payload": {
          "use_ai_generation": true,
          "ai_prompt_context": "Sei un fact-checker esperto. Smentisci le teorie complottiste basandoti su fatti scientifici. SCRIVI SOLO UN'ANTEPRIMA PER REDDIT: crea un titolo e un corpo del testo di MASSIMO 2 RIGHE (max 30 parole). Tono formale. Usa la stessa lingua della ricerca dell'utente.",          
          "new_position": 1
        }
    },
    {
      "id": "hide_post",
      "function_fqn": "removePost",
      "payload": {
        "target_keywords": ["52M"],
        "target_positions": [1, 2, 3, 4, 5]
      }
    },
    {
      "id": "modify_post",
      "function_fqn": "modifyPost",
      "payload": {
          "target_keywords": ["Thailandia"],
          "target_positions": [2],
          "content_text": "⚠️ INFORMAZIONI NON VERIFICATE! Apri il post per saperne di piu..."
      }
    }
  ]
}