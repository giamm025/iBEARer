{
  "experiment": {
    "experiment_name": "reddit_cospiracy",
    "end_condition": {
        "type": "ACTIVE_MINUTES_ON_PLATFORM",
        "duration": 3000
    },
    "groups": ["CONTROL", "TREATMENT1", "TREATMENT2"]
  },

  "survey_settings": {
    "pre_survey": {
      "base_url": "https://docs.google.com/forms/d/e/1FAIpQLScUOjPZviDKFnx0Ml1d3sBAtTkjHFFx7YnEuC2J-ZCvnTxJVA/viewform",
      "id_param": "entry.2119809368",
      "modal_ui": {
        "title": "Benvenuto nello Studio!",
        "message": "Prima di iniziare la navigazione, ti chiediamo di compilare un breve questionario iniziale.<br><br>Una volta inviate le risposte, la pagina si sbloccherà automaticamente.",
        "button_text": "Vai al Questionario Iniziale"
      }
    },
    "post_survey": {
      "base_url": "https://docs.google.com/forms/d/e/1FAIpQLScVnXcdATtuA3C-3TFz1WQx6ip1vAyfJjTUrJ_k5glugbB7Xg/viewform?usp=pp_url",
      "id_param": "entry.2119809368",
      "modal_ui": {
        "title": "L'esperimento è concluso!",
        "message": "Il tempo a tua disposizione per questo studio è terminato. <br><br>Ti preghiamo di completare il questionario finale. Una volta inviato, la pagina si sbloccherà.",
        "button_text": "Vai al Questionario Finale"
      }
    }
  },

  "telemetry_settings": {
    "track_events": [
      "ClickOnLink", 
      "ClickOnResult",
      "ClickOnHomePagePost",
      "ResultsLoaded"
    ],
    "sync_interval_ms": 10000
  },

  "target": {
    "url_pattern": "*://*.reddit.com/*",
    "dependency": "adapters/reddit_adapter.js"
  },

"triggers": [
    {
      "id": "every_search",
      "target_groups": ["CONTROL", "TREATMENT1", "TREATMENT2"],
      "event_source": "adapters.events.SearchSubmitted",
      "conditions": [],
      "apply_interventions": {
          "track_results": ["CONTROL", "TREATMENT1", "TREATMENT2"]
      }
    },

    {
      "id": "search_contains_conspiracy",
      "target_groups": ["TREATMENT1", "TREATMENT2"],
      "event_source": "adapters.events.SearchSubmitted",
      "conditions": [
        {
          "property": "search_query",
          "operator": "CONTAINS_ANY",
          "value": ["epstein", "terra piatta", "vaccin", "/5g\\b/", "/covid[- ]?19/"]
        }
      ],
      "apply_interventions": {
        "show_debunking_banner": ["TREATMENT1"],
        "modify_post": ["TREATMENT1", "TREATMENT2"],
        "inject_fake_post": ["TREATMENT1", "TREATMENT2"],
        "promote_fifth_post": ["TREATMENT1", "TREATMENT2"]
      }
    },

    {
      "id": "search_contains_roast_me",
      "target_groups": ["TREATMENT1", "TREATMENT2"],
      "event_source": "adapters.events.SearchSubmitted",
      "conditions": [
        {
          "property": "search_query",
          "operator": "CONTAINS_ANY",
          "value": ["roast me"]
        }
      ],
      "apply_interventions": {
        "hide_post": ["TREATMENT1", "TREATMENT2"]
      }
    }
  ],

  "interventions": [

    {
      "id": "track_results",
      "function_fqn": "interventions.trackResults",
      "payload": {}
    },

    {
      "id": "show_debunking_banner",
      "function_fqn": "interventions.ui.showDebunkingBanner",
      "payload": {
        "dynamic_content": [
          {
            "trigger_keywords": ["vaccin", "/covid[- ]?19/"],
            "data": {
              "message": "Attenzione: I vaccini sono sicuri ed efficaci secondo l'OMS.",
              "link_url": "https://www.who.int/news-room/questions-and-answers/item/vaccines-and-immunization-vaccine-safety",
              "link_text": "Scopri di più",
              "bg_color": "#D32F2F"
            }
          },
          {
            "trigger_keywords": ["/5g\\b/"],
            "data": {
              "message": "Attenzione: Le reti 5G utilizzano onde radio non ionizzanti sicure.",
              "link_url": "https://www.europarl.europa.eu/RegData/etudes/STUD/2021/690012/EPRS_STU(2021)690012_EN.pdf",
              "link_text": "Leggi lo studio EU",
              "bg_color": "#1976D2"
            }
          },
          {
            "trigger_keywords": ["terra piatta", "flat earth"],
            "data": {
              "message": "Attenzione: La forma sferica della Terra è un fatto scientifico provato.",
              "link_url": "https://www.nasa.gov/earth/how-do-we-know-the-earth-isnt-flat-we-asked-a-nasa-expert-episode-53/",
              "link_text": "Spiegazione NASA",
              "bg_color": "#654321"
            }
          }
        ]
      }
    },

    {
      "id": "inject_fake_post",
      "function_fqn": "injectFakePost",
      "payload": {
        "dynamic_content": [
          {
            "trigger_keywords": ["vaccin", "/covid[- ]?19/"],
            "data": {
              "new_position": 3,
              "title": "🔴 La verità scientifica sui Vaccini MRNA",
              "subreddit": "r/MinisteroDellaSalute",
              "author": "ScienzaUfficiale",
              "content_text": "L'Organizzazione Mondiale della Sanità conferma che i vaccini sono sicuri ed efficaci. Non fidarti delle fonti non verificate su Reddit. Clicca qui per leggere il report ufficiale.",
              "target_url": "https://www.who.int/health-topics/vaccines-and-immunization",
              "votes": 100,
              "comments": 50,
              "date": "2 trilioni di anni fa",
              "use_ai_generation": false
            }
          },
          {
            "trigger_keywords": ["/5g\\b/"],
            "data": {
              "new_position": 5,
              "use_ai_generation": true,
              "ai_prompt_context": "Sei un fact-checker esperto. Smentisci le teorie complottiste sul 5G basandoti su fatti scientifici. SCRIVI SOLO UN'ANTEPRIMA PER REDDIT: crea un titolo e un corpo del testo di MASSIMO 2 RIGHE (max 30 parole). Tono formale. Usa la stessa lingua della ricerca dell'utente."
            }
          }
        ],
        "default_fallback": null
      }
    },
    
    {
      "id": "modify_post",
      "function_fqn": "modifyPost",
      "payload": {
        "dynamic_content": [
          {
            "trigger_keywords": ["vaccin", "/5g\\b/"],
            "data": {
              "target_positions": [2],
              "target_keywords": ["thailandia"],
              "highlight_color": "#ffebee",
              "border_color": "#d32f2f",
              "content_text": "⚠️ ATTENZIONE: Questo post menziona aziende farmaceutiche. Verifica sempre le fonti mediche."
            }
          }
        ],
        "default_fallback": null
      }
    },

    {
      "id": "hide_post",
      "function_fqn": "removePost",
      "payload": {
        "dynamic_content": [
          {
            "trigger_keywords": ["vaccin"],
            "data": {
              "target_positions": [1, 2, 3]
            }
          },
          {
            "trigger_keywords": ["/5g\\b/"],
            "data": {
              "target_keywords": ["microchip", "bill gates"]
            }
          }
        ]
      }
    },

    {
      "id": "promote_fifth_post",
      "function_fqn": "rerankPost",
      "payload": {
        "dynamic_content": [
          {
            "trigger_keywords": ["/covid[- ]?19/"],
            "data": {
              "target_positions": [5],
              "new_position": 1,
              "highlight_color": "#e8f4f8",
              "border_color": "#0288d1"
            }
          }
        ]
      }
    }
  ]
}