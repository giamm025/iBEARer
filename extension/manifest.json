{
  "manifest_version": 3,
  "name": "Reddit Conspiracy Experiment",
  "version": "1.0.0",
  "description": "Estensione di ricerca per manipolazione DOM su Reddit.",
  
  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "http://localhost:8000/*"  
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["*://*.reddit.com/*"],
      "js": [
        "utils/logger.js",
        "adapters/utils/SpaWatcher.js",
        "services/ApiManager.js",

        "engine/operators/CONTAINS_ANY.js",
        "engine/operators/NOT_CONTAINS_ANY.js",
        "engine/operators/EQUALS.js",

        "engine/interventions/debug/applyBorder.js",
        "engine/interventions/ui/showDebunkingBanner.js", 

        "engine/interventions/ui/formatPost.js", 
        "engine/interventions/ui/injectFakePost.js", 
        "engine/interventions/ui/removePost.js", 
        "engine/interventions/trackResults.js", 
        
        "engine/core_engine.js",

        "adapters/events/SearchSubmittedEvent.js",
        "adapters/events/EngineReadyEvent.js",

        "adapters/observers/platform_dependent/SearchSubmittedObserver.js",
        "adapters/observers/platform_dependent/ResultsLoadedObserver.js",
        "adapters/observers/platform_dependent/ClickOnResultObserver.js",

        "adapters/observers/platform_independent/ClickOnLinkObserver.js",
        "adapters/observers/platform_independent/TimeOnPageObserver.js",

        "adapters/reddit_adapter.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": ["*://docs.google.com/forms/*"],
      "js": ["adapters/utils/FormWatcher.js"]
    }
  ]
}