{
  "manifest_version": 3,
  "name": "Reddit Conspiracy Experiment",
  "version": "1.0.0",
  "description": "Estensione di ricerca per manipolazione DOM su Reddit.",
  
  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "http://localhost:8000/*"  
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["*://*.reddit.com/*"],
      "js": [
        "core/utils/Logger.js",
        "core/utils/SpaWatcher.js",

        "core/interfaces/BasePlatformAdapter.js",
        "core/interfaces/BaseEvent.js",
        "core/interfaces/BaseObserver.js",
        "core/interfaces/BaseTriggerObserver.js",
        "core/interfaces/BaseOperator.js",
        "core/interfaces/BaseIntervention.js",
        "core/interfaces/BasePostIntervention.js",
        
        "adapters/reddit/RedditAdapter.js",
        "adapters/PlatformAdapter.js",
        
        "core/services/ApiManager.js",
        "core/services/SurveyManager.js",
        "core/services/TimerManager.js",

        "core/operators/ContainsAny.js",
        "core/operators/NotContainsAny.js",
        "core/operators/Equals.js",
 
        "interventions/ApplyBorder.js",
        "interventions/ShowDebunkingBanner.js",
        "interventions/InjectFakePost.js", 
        "interventions/RemovePost.js", 
        "interventions/ModifyPost.js",
        "interventions/RerankPost.js",
        "interventions/TrackResults.js",

        "events/EngineReadyEvent.js",       
        "events/SearchSubmittedEvent.js",

        "observers/telemetry/ResultsLoadedObserver.js",
        "observers/telemetry/ClickOnResultObserver.js",
        "observers/telemetry/ClickOnHomePagePostObserver.js",
        "observers/telemetry/ClickOnLinkObserver.js",
        "observers/telemetry/TimeOnPageObserver.js",
        "observers/trigger/SearchSubmittedObserver.js",

        "core/engine/CoreEngine.js",

        "main.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": ["*://docs.google.com/forms/*"],
      "js": ["adapters/google-forms/FormWatcher.js"]
    }
  ]
}