{
  "manifest_version": 3,
  "name": "Reddit Conspiracy Experiment",
  "version": "1.0.0",
  "description": "Estensione di ricerca per manipolazione DOM su Reddit.",
  
  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://bear.spect.ing/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["*://*.reddit.com/*"],
      "js": [
        "utils/Logger.js",
        "utils/SpaWatcher.js",
        "services/ApiManager.js",
        "services/SurveyManager.js",
        "services/TimerManager.js",

        "engine/interfaces/BaseOperator.js",

        "engine/operators/ContainsAny.js",
        "engine/operators/NotContainsAny.js",
        "engine/operators/Equals.js",

        "engine/interfaces/BaseIntervention.js",

        "adapters/reddit/interventions/debug/ApplyBorder.js",
        "adapters/reddit/interventions/ui/ShowDebunkingBanner.js",

        "adapters/reddit/interventions/interfaces/BasePostIntervention.js",  
        "adapters/reddit/interventions/ui/InjectFakePost.js", 
        "adapters/reddit/interventions/ui/RemovePost.js", 
        "adapters/reddit/interventions/ui/ModifyPost.js",
        "adapters/reddit/interventions/ui/RerankPost.js",
        
        "adapters/reddit/interventions/tracking/TrackResults.js",

        "engine/events/EngineReadyEvent.js",
                        
        "engine/interfaces/BaseEvent.js",
        "adapters/reddit/events/SearchSubmittedEvent.js",

        "engine/interfaces/BaseObserver.js",
        "engine/interfaces/BaseTriggerObserver.js"
        ,
        "adapters/reddit/observers/telemetry/ResultsLoadedObserver.js",
        "adapters/reddit/observers/telemetry/ClickOnResultObserver.js",
        "adapters/reddit/observers/telemetry/ClickOnHomePagePostObserver.js",
        "adapters/reddit/observers/telemetry/ClickOnLinkObserver.js",
        "adapters/reddit/observers/telemetry/TimeOnPageObserver.js",

        "adapters/reddit/observers/trigger/SearchSubmittedObserver.js",

        "adapters/reddit/RedditAdapter.js",
        "engine/CoreEngine.js",

        "main.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": ["*://docs.google.com/forms/*"],
      "js": ["adapters/google-forms/FormWatcher.js"]
    }
  ]
}