{
  "manifest_version": 3,
  "name": "Reddit Conspiracy Experiment",
  "version": "1.0.0",
  "description": "Estensione di ricerca per manipolazione DOM su Reddit.",
  
  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "http://localhost:8000/*"  
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["*://*.reddit.com/*"],
      "js": [
        "utils/logger.js",
        "adapters/utils/SpaWatcher.js",
        "services/ApiManager.js",

        "engine/operators/index.js",
        "engine/operators/CONTAINS_ANY.js",
        "engine/operators/NOT_CONTAINS_ANY.js",
        "engine/operators/EQUALS.js",

        "engine/interventions/index.js",
        "engine/interventions/debug/applyBorder.js",
        "engine/interventions/ui/showDebunkingBanner.js",  

        "engine/core_engine.js",

        "adapters/events/SearchResultsLoadedEvent.js",
        "adapters/events/EngineReadyEvent.js",
        "adapters/observers/SearchObserver.js",
        "adapters/reddit_adapter.js"
      ],
      "run_at": "document_end"
    }
  ]
}