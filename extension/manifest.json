{
  "manifest_version": 3,
  "name": "Reddit Conspiracy Experiment",
  "version": "1.0.0",
  "description": "Estensione di ricerca per manipolazione DOM su Reddit.",
  
  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "http://localhost:8000/*"  
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["*://*.reddit.com/*"],
      "js": [
        "utils/logger.js",
        "utils/SpaWatcher.js",
        "services/ApiManager.js",
        "services/SurveyManager.js",
        "services/TimerManager.js",

        
        "engine/operators/CONTAINS_ANY.js",
        "engine/operators/NOT_CONTAINS_ANY.js",
        "engine/operators/EQUALS.js",
        
        "engine/interventions/BaseIntervention.js",

        "engine/interventions/debug/applyBorder.js",
        "engine/interventions/ui/showDebunkingBanner.js",

        "engine/interventions/ui/PostProcessorIntervention.js",  
        "engine/interventions/ui/injectFakePost.js", 
        "engine/interventions/ui/removePost.js", 
        "engine/interventions/ui/modifyPost.js",
        
        "engine/interventions/tracking/trackResults.js",

        "engine/events/EngineReadyEvent.js",
                        
        "adapters/events/BaseEvent.js",
        "adapters/events/SearchSubmittedEvent.js",

        "adapters/observers/BaseObserver.js",
        "adapters/observers/trigger-event-sources/SearchSubmittedObserver.js",
        "adapters/observers/telemetry-track-events/ResultsLoadedObserver.js",
        "adapters/observers/telemetry-track-events/ClickOnResultObserver.js",
        "adapters/observers/telemetry-track-events/ClickOnLinkObserver.js",
        "adapters/observers/telemetry-track-events/TimeOnPageObserver.js",

        "adapters/RedditAdapter.js",
        "engine/core_engine.js",

        "main.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": ["*://docs.google.com/forms/*"],
      "js": ["adapters/google-forms/FormWatcher.js"]
    }
  ]
}