        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph LR\n    %% Definizione degli stili (Color Coding)\n    classDef stable fill:#d4edda,stroke:#28a745,stroke-width:2px,color:#155724\n    classDef platform fill:#fff3cd,stroke:#ffc107,stroke-width:2px,color:#856404\n    classDef experiment fill:#f8d7da,stroke:#dc3545,stroke-width:2px,color:#721c24\n    classDef base fill:#f8f9fa,stroke:#ced4da,stroke-width:2px,color:#212529\n    classDef hypothetical fill:#fff3cd,stroke:#ffc107,stroke-width:2px,stroke-dasharray: 5 5,color:#856404\n\n    Root[\&quot;iBEARer Project\&quot;]:::base\n\n    %% Core stabile (Non si tocca)\n    Core[\&quot;Core System&lt;br&gt;(Nessuna Modifica)\&quot;]:::stable\n    Root --&gt; Core\n    \n    Core --&gt; Backend[\&quot;backend/api/&lt;br&gt;(Views, Models, WebSockets)\&quot;]:::stable\n    Core --&gt; Engine[\&quot;extension/engine/&lt;br&gt;(CoreEngine, Events, Operators)\&quot;]:::stable\n    Core --&gt; Services[\&quot;extension/services/&lt;br&gt;(ApiManager, TimerManager, ecc.)\&quot;]:::stable\n\n    %% Specifico Piattaforma (Si tocca solo per nuove piattaforme)\n    Plat[\&quot;Platform Adapters&lt;br&gt;(Nuova Piattaforma)\&quot;]:::platform\n    Root --&gt; Plat\n    \n    Plat --&gt; Reddit[\&quot;adapters/reddit/&lt;br&gt;(RedditAdapter, Interventions)\&quot;]:::platform\n    Plat --&gt; YT[\&quot;adapters/youtube/&lt;br&gt;(YoutubeAdapter - Ipotetico)\&quot;]:::hypothetical\n\n    %% Specifico Esperimento (Si tocca per ogni esperimento)\n    Exp[\&quot;Experiment Config&lt;br&gt;(Nuovo Esperimento)\&quot;]:::experiment\n    Root --&gt; Exp\n    \n    Exp --&gt; Config[\&quot;backend/config.json&lt;br&gt;(Definizione payload e triggers)\&quot;]:::experiment&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="AoXJ-jN8PxtpiBUKiA2z-1">
